{
  "name": "agent-autoloop",
  "version": "1.0.0",
  "description": "Let Agents follow up on work and ask when they need your judgment.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KKKKhazix/agent-autoloop.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agent-autoloop": "bin/agent-autoloop.ts",
    "agent-company": "bin/agent-company.ts"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "test:quick": "node --disable-warning=ExperimentalWarning --test $(ls tests/*.test.ts | grep -v /simulation.test.ts)",
    "typecheck": "tsc -p .",
    "format": "prettier --write \"**/*.{ts,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,yml}\"",
    "test:nightly": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 sim/*.test.ts && node --disable-warning=ExperimentalWarning scripts/benchmark.ts --check",
    "benchmark": "node --disable-warning=ExperimentalWarning scripts/benchmark.ts --check",
    "company": "node --disable-warning=ExperimentalWarning bin/agent-company.ts",
    "company:demo": "node --disable-warning=ExperimentalWarning --test tests/company-e2e.test.ts",
    "test:fast": "node scripts/test-tier.ts fast",
    "test:slow": "node scripts/test-tier.ts slow"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "prettier": {
    "printWidth": 120
  }
}
