[Unit]
Description=Push sanitized company status to its private repository
After=network-online.target

[Service]
Type=oneshot
User=agentstatus
Group=agentstatus
Environment=HOME=/var/lib/agent-status
Environment=PATH=/usr/bin:/bin
ExecStart=/opt/agent-company/runtime/node_modules/.bin/node --disable-warning=ExperimentalWarning /opt/agent-company/app/cli/company-status-snapshot.ts push /var/lib/agent-status-inbox /var/lib/agent-status/repository fusae/agent-company-status /var/lib/agent-status/id_ed25519
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agent-status
InaccessiblePaths=/var/lib/agent-company
UMask=0077
